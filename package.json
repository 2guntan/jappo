{
  "name": "jappo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "turbo run test",
    "test:int": "pnpm --filter @jappo/api test:int",
    "e2e": "pnpm --filter @jappo/web e2e",
    "e2e:full": "pnpm --filter @jappo/web e2e:full",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:int && pnpm e2e",
    "db:generate": "pnpm --filter @jappo/api db:generate",
    "db:migrate": "pnpm --filter @jappo/api db:migrate",
    "seed": "pnpm --filter @jappo/api seed",
    "sdk:gen": "pnpm --filter @jappo/api openapi:export && pnpm --filter @jappo/sdk gen",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver", "@tailwindcss/oxide", "cpu-features", "ssh2", "protobufjs"]
  }
}
