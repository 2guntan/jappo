{
  "name": "@jappo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jobs": "./src/jobs/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli.ts migrate",
    "seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed",
    "openapi:export": "tsx src/cli.ts openapi > ../../packages/sdk/openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@jappo/contracts": "workspace:*",
    "@jappo/domain": "workspace:*",
    "@jappo/templates": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^6.0.0",
    "handlebars": "^4.7.10",
    "jose": "^6.1.0",
    "nodemailer": "^7.0.0",
    "otpauth": "^9.4.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.0",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@jappo/config": "workspace:*",
    "@testcontainers/postgresql": "^11.7.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
