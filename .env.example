# ---- Core ----
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://jappo:jappo@localhost:5432/jappo
LOG_LEVEL=info

# ---- Secrets (generate: openssl rand -base64 32) ----
JWT_SECRET=change-me-change-me-change-me-change-me-32b
PII_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PII_HMAC_KEY=change-me-hmac-key-change-me-hmac-key
FILE_URL_SIGNING_KEY=change-me-file-signing-key-change-me
WEBHOOK_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ---- Security ----
MFA_ENFORCE=true
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
OTP_REDACT_AFTER_DELIVERY=true

# ---- Storage (s3 = MinIO/S3, fs = local directory) ----
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jappo
S3_ACCESS_KEY=jappo
S3_SECRET_KEY=jappo-dev-secret
S3_FORCE_PATH_STYLE=true
FS_STORAGE_DIR=./.data/files

# ---- Email (smtp | memory) ----
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Jappo <no-reply@jappo.local>"

# ---- SMS (console | http_generic) ----
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_BODY_TEMPLATE={"to":"{{to}}","text":"{{text}}"}

# ---- Payouts ----
PAYOUT_PROVIDERS=manual_csv,wave_bulk_csv,orange_money_bulk_csv

# ---- Seed ----
SEED_ADMIN_PASSWORD=Jappo-Admin-2026!
